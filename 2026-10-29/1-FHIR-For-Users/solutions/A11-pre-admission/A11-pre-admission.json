        {
          "url": "name",
          "valueCoding": {
            "system": "http://hl7.org/fhir/uv/sdc/CodeSystem/launchContext",
            "code": "patient"
          }
        },
        {
          "url": "type",
          "valueCode": "Patient"
        }
      ]
    }
  ],
  "url": "https://aehrc.github.io/qh-connectathon/track1/solutions/Questionnaire/A11-pre-admission",
  "version": "0.2.0",
  "name": "PAMPreAdmissionPatient",
  "title": "Before your operation: your blood and iron health",
  "status": "draft",
  "experimental": true,
  "date": "2026-10-28",
  "publisher": "FHIR in Queensland Health Connectathon — Track 1 (synthetic demo, not for clinical use)",
  "description": "Scenario A11: a patient-facing pre-admission form in plain language (history, diet, transfusion wishes). Its QuestionnaireResponse is what the nurse's forms pre-populate from.",
  "item": [
    {
      "linkId": "pam-pre-admission",
      "text": "Before your operation",
      "type": "group",
      "item": [
        {
          "linkId": "pam-pre-admission-module",
          "text": "Module",
          "type": "string",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-hidden",
              "valueBoolean": true
            }
          ],
          "initial": [
            {
              "valueString": "pam-pre-admission|0.2.0"
            }
          ]
        },
        {
          "linkId": "pam-pa-intro",
          "text": "This form takes about 5 minutes. Your answers go to the blood management nurse, who will look at them before your pre-admission appointment.",
          "type": "display"
        },
        {
          "linkId": "pam-pa-about",
          "text": "About you",
          "type": "group",
          "item": [
            {
              "linkId": "pam-pa-about-intro",
              "text": "We have filled in some details from your hospital record. Please check them and fix anything that is wrong.",
              "type": "display"
            },
            {
              "linkId": "pam-pa-name",
              "text": "Your name",
              "type": "string",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.name.where(use = 'official').union(%patient.name).first().select(given.first() + ' ' + family)"
                  }
                }
              ]
            },
            {
              "linkId": "pam-pa-dob",
              "text": "Your date of birth",
              "type": "date",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.birthDate"
                  }
                }
              ]
            },
            {
              "linkId": "pam-pa-sex",
              "text": "Your sex",
              "type": "choice",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.gender"
                  }
                }
              ],
              "answerOption": [
                {
                  "valueCoding": {
                    "system": "http://hl7.org/fhir/administrative-gender",
                    "code": "female",
                    "display": "Female"
                  }
                },
                {
                  "valueCoding": {
                    "system": "http://hl7.org/fhir/administrative-gender",
                    "code": "male",
                    "display": "Male"
                  }
                },
                {
                  "valueCoding": {
                    "system": "http://hl7.org/fhir/administrative-gender",
                    "code": "other",
                    "display": "Other"
                  }
                },
                {
                  "valueCoding": {
                    "system": "http://hl7.org/fhir/administrative-gender",
                    "code": "unknown",
                    "display": "Prefer not to say"
                  }
                }
              ]
            },
            {
              "linkId": "pam-pa-medicare",
              "text": "Your Medicare number",
              "type": "string",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.identifier.where(system = 'http://ns.electronichealth.net.au/id/medicare-number').value.first()"
                  }
                }
              ]
            },
            {
              "linkId": "pam-pa-phone",
              "text": "Best phone number to reach you",
              "type": "string",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.telecom.where(system = 'phone').where(use = 'mobile').union(%patient.telecom.where(system = 'phone')).value.first()"
                  }
                }
              ]
            },
            {
              "linkId": "pam-pa-address",
              "text": "Your home address",
              "type": "string",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.address.where(use = 'home').union(%patient.address).first().select(iif(line.exists(), line.join(', ') + ', ', '') & city & ' ' & state & ' ' & postalCode)"
                  }
                }
              ]
            },
            {
              "linkId": "pam-pa-language",
              "text": "The language you prefer to speak",
              "type": "string",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.communication.where(preferred = true).union(%patient.communication).first().language.select(text | coding.display).first()"
                  }
                }
              ]
            },
            {
              "linkId": "pam-pa-interpreter",
              "text": "Do you need an interpreter?",
              "type": "boolean",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.extension.where(url = 'http://hl7.org.au/fhir/StructureDefinition/interpreter-required').value"
                  }
                }
              ]
            }
          ]
        },
        {
