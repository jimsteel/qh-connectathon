  ],
  "url": "https://aehrc.github.io/qh-connectathon/track1/solutions/Questionnaire/pam-patient-reported",
  "version": "0.2.0",
  "name": "PAMPatientReported",
  "title": "PAM module — Patient-reported (from the pre-admission form)",
  "status": "draft",
  "experimental": true,
  "date": "2026-10-28",
  "publisher": "FHIR in Queensland Health Connectathon — Track 1 (synthetic demo, not for clinical use)",
  "description": "Scenario A11, nurse side: pre-populates from the patient's latest completed A11 pre-admission QuestionnaireResponse (x-fhir-query + FHIRPath).",
  "item": [
    {
      "linkId": "pam-patient-reported",
      "text": "Patient-reported (pre-admission form)",
      "type": "group",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/variable",
          "valueExpression": {
            "name": "paResponse",
            "language": "application/x-fhir-query",
            "expression": "QuestionnaireResponse?subject=Patient/{{%patient.id}}&status=completed&_sort=-authored&_count=50"
          }
        }
      ],
      "item": [
        {
          "linkId": "pam-patient-reported-module",
          "text": "Module",
          "type": "string",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-hidden",
              "valueBoolean": true
            }
          ],
          "initial": [
            {
              "valueString": "pam-patient-reported|0.2.0"
            }
          ]
        },
        {
          "linkId": "pam-pr-source",
          "text": "Patient's form",
          "type": "string",
          "readOnly": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%paResponse.entry.resource.where(questionnaire.startsWith('https://aehrc.github.io/qh-connectathon/track1/solutions/Questionnaire/A11-pre-admission')).first().select('Completed ' + authored.toString().substring(0, 10) + ' (QuestionnaireResponse/' + id + ')')"
              }
            }
          ]
        },
        {
          "linkId": "pam-pr-none",
          "text": "The patient hasn't completed a pre-admission form yet.",
          "type": "display",
          "enableWhen": [
            {
              "question": "pam-pr-source",
              "operator": "exists",
              "answerBoolean": false
            }
          ]
        },
        {
          "linkId": "pam-pr-transfusion-accept",
          "text": "Would accept a blood transfusion",
          "type": "choice",
