              }
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "system": "https://aehrc.github.io/qh-connectathon/track1/CodeSystem/transfusion-preference",
                "code": "accept",
                "display": "Yes, I would accept a blood transfusion"
              }
            },
            {
              "valueCoding": {
                "system": "https://aehrc.github.io/qh-connectathon/track1/CodeSystem/transfusion-preference",
                "code": "some",
                "display": "Only some blood products"
              }
            },
            {
              "valueCoding": {
                "system": "https://aehrc.github.io/qh-connectathon/track1/CodeSystem/transfusion-preference",
                "code": "refuse",
                "display": "No, I would not accept any blood products"
              }
