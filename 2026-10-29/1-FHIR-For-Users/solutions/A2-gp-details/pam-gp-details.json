              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%gpReferral.entry.resource.where(resourceType='ServiceRequest').authoredOn.toString().substring(0, 10)"
                  }
                }
              ]
            }
          ]
        },
        {
          "linkId": "pam-gp-admission",
          "text": "GP recorded on the latest admission",
          "type": "group",
          "enableWhen": [
            {
              "question": "pam-gp-source",
              "operator": "=",
              "answerCoding": {
                "system": "https://aehrc.github.io/qh-connectathon/track1/CodeSystem/gp-source",
                "code": "admission",
                "display": "GP from the latest admission"
              }
            }
          ],
          "item": [
            {
              "linkId": "pam-gp-admission-name",
              "text": "Name",
              "type": "string",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "iif(%gpAdmissionPrac.exists(), %gpAdmissionPrac.name.first().select(iif(prefix.exists(), prefix.first() + ' ', '') + given.first() + ' ' + family), %gpAdmissionRef.display)"
                  }
                }
              ],
              "readOnly": true
            },
            {
              "linkId": "pam-gp-admission-practice",
              "text": "Practice",
              "type": "string",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "iif(%gpAdmissionOrg.exists(), %gpAdmissionOrg.name, %gpAdmissionTarget.where(resourceType='PractitionerRole').organization.display)"
                  }
                }
              ],
              "readOnly": true
            },
            {
              "linkId": "pam-gp-admission-phone",
              "text": "Phone",
              "type": "string",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "(%gpAdmissionTarget.where(resourceType='PractitionerRole').telecom.where(system='phone') | %gpAdmissionOrg.telecom.where(system='phone') | %gpAdmissionPrac.telecom.where(system='phone')).value.first()"
                  }
                }
              ],
              "readOnly": true
            },
            {
              "linkId": "pam-gp-admission-provider",
              "text": "Provider number",
              "type": "string",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%gpAdmissionPrac.identifier.where(system='http://ns.electronichealth.net.au/id/medicare-provider-number').value.first()"
                  }
                }
              ],
              "readOnly": true
            },
            {
              "linkId": "pam-gp-admission-ref",
              "text": "Reference",
              "type": "string",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-hidden",
                  "valueBoolean": true
                },
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%gpAdmissionRef.reference"
                  }
                }
              ],
              "readOnly": true
            },
            {
              "linkId": "pam-gp-admission-date",
              "text": "Admitted",
              "type": "date",
              "readOnly": true,
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%gpAdmission.entry.resource.where(resourceType='Encounter').period.start.toString().substring(0, 10)"
                  }
                }
              ]
            }
          ]
        },
        {
          "linkId": "pam-gp-manual",
          "text": "Enter the GP",
          "type": "group",
          "enableWhen": [
            {
              "question": "pam-gp-source",
              "operator": "=",
              "answerCoding": {
                "system": "https://aehrc.github.io/qh-connectathon/track1/CodeSystem/gp-source",
                "code": "manual",
                "display": "Enter the GP manually"
              }
            }
          ],
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtract",
              "extension": [
                {
                  "url": "template",
                  "valueReference": {
                    "reference": "#PAMGpPractitionerTemplate"
                  }
                },
                {
                  "url": "resourceId",
                  "valueString": "'soln-A2-gp-' + (repeat(item).where(linkId='pam-gp-manual-family').answer.value.lower() + iif(repeat(item).where(linkId='pam-gp-manual-given').answer.value.exists(), '-' + repeat(item).where(linkId='pam-gp-manual-given').answer.value.lower(), '') + iif(repeat(item).where(linkId='pam-gp-manual-provider').answer.value.exists(), '-' + repeat(item).where(linkId='pam-gp-manual-provider').answer.value.lower(), '')).replaceMatches('[^a-z0-9-]', '').substring(0, 50)"
                }
              ]
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtract",
              "extension": [
                {
                  "url": "template",
                  "valueReference": {
                    "reference": "#PAMGpRoleTemplate"
                  }
                },
                {
                  "url": "resourceId",
                  "valueString": "'soln-A2-gp-' + (repeat(item).where(linkId='pam-gp-manual-family').answer.value.lower() + iif(repeat(item).where(linkId='pam-gp-manual-given').answer.value.exists(), '-' + repeat(item).where(linkId='pam-gp-manual-given').answer.value.lower(), '') + iif(repeat(item).where(linkId='pam-gp-manual-provider').answer.value.exists(), '-' + repeat(item).where(linkId='pam-gp-manual-provider').answer.value.lower(), '')).replaceMatches('[^a-z0-9-]', '').substring(0, 50) + '-role'"
                }
              ]
            }
          ],
          "item": [
            {
              "linkId": "pam-gp-manual-name",
              "text": "Name",
              "type": "group",
              "item": [
                {
                  "linkId": "pam-gp-manual-given",
                  "text": "Given name",
                  "type": "string"
                },
                {
                  "linkId": "pam-gp-manual-family",
                  "text": "Family name",
                  "type": "string",
                  "required": true
                }
              ]
            },
            {
              "linkId": "pam-gp-manual-provider",
              "text": "Medicare provider number",
              "type": "string"
            },
            {
              "linkId": "pam-gp-manual-practice",
              "text": "Practice",
              "type": "string"
            },
            {
              "linkId": "pam-gp-manual-phone",
              "text": "Practice phone",
              "type": "string"
            }
          ]
        },
        {
          "linkId": "pam-gp-new-display",
          "text": "GP to be recorded",
          "type": "string",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%resource.repeat(item).where(linkId='pam-gp-source').answer.value.code = 'current', %resource.repeat(item).where(linkId='pam-gp-current-name').answer.value, iif(%resource.repeat(item).where(linkId='pam-gp-source').answer.value.code = 'referring', %resource.repeat(item).where(linkId='pam-gp-referring-name').answer.value, iif(%resource.repeat(item).where(linkId='pam-gp-source').answer.value.code = 'admission', %resource.repeat(item).where(linkId='pam-gp-admission-name').answer.value, iif(%resource.repeat(item).where(linkId='pam-gp-source').answer.value.code = 'manual' and %resource.repeat(item).where(linkId='pam-gp-manual-family').answer.value.exists(), 'Dr ' + iif(%resource.repeat(item).where(linkId='pam-gp-manual-given').answer.value.exists(), %resource.repeat(item).where(linkId='pam-gp-manual-given').answer.value + ' ', '') + %resource.repeat(item).where(linkId='pam-gp-manual-family').answer.value, {}))))"
              }
            }
          ],
          "readOnly": true
        }
      ]
    }
  ]
}
