{
  "resourceType": "Questionnaire",
  "id": "soln-pam-root",
  "extension": [
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-assemble-expectation",
      "valueCode": "assemble-root"
    },
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-launchContext",
      "extension": [
        {
          "url": "name",
          "valueCoding": {
            "system": "http://hl7.org/fhir/uv/sdc/CodeSystem/launchContext",
            "code": "user"
          }
        },
        {
          "url": "type",
          "valueCode": "Practitioner"
        }
      ]
    },
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-launchContext",
      "extension": [
        {
          "url": "name",
          "valueCoding": {
            "system": "http://hl7.org/fhir/uv/sdc/CodeSystem/launchContext",
            "code": "patient"
          }
        },
        {
          "url": "type",
          "valueCode": "Patient"
        }
      ]
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "sexCode",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-sex').answer.value.code"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "dob",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-dob').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "heightCm",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-height').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "weightKg",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-weight').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "hb",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-hb').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "ferritin",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-ferritin').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "tsat",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-tsat').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "crp",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-crp').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "mcv",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-mcv').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "egfr",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-egfr').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "surgeryDate",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-surgery-date').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "hbThreshold",
        "language": "text/fhirpath",
        "expression": "iif(%sexCode = 'male', 130, iif(%sexCode = 'female', 120, {}))"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "anaemia",
        "language": "text/fhirpath",
        "expression": "%hb <= %hbThreshold"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "ironDeficiency",
        "language": "text/fhirpath",
        "expression": "%ferritin < 100 or (%tsat < 20 and %ferritin >= 100 and %ferritin <= 300)"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "inflammation",
        "language": "text/fhirpath",
        "expression": "%crp > 10"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "pathway",
        "language": "text/fhirpath",
        "expression": "iif(%anaemia.empty() or %ironDeficiency.empty(), {}, iif(%anaemia, iif(%ferritin < 100, 'ida', iif(%ironDeficiency, iif(%inflammation, 'acd', 'ida'), 'anaemia')), iif(%ironDeficiency, 'id', 'none')))"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "suggestedDxCode",
        "language": "text/fhirpath",
        "expression": "iif(%pathway = 'ida', '87522002', iif(%pathway = 'acd', '234347009', iif(%pathway = 'id', '35240004', iif(%pathway = 'anaemia', '271737000', {}))))"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "actualHb",
        "language": "text/fhirpath",
        "expression": "%hb"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "idealWeight",
        "language": "text/fhirpath",
        "expression": "iif(%sexCode = 'male', 50, 45.5) + 0.9 * (%heightCm - 152.4)"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "weight",
        "language": "text/fhirpath",
        "expression": "iif(%idealWeight.exists() and %idealWeight < %weightKg, %idealWeight, %weightKg)"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "targetHb",
        "language": "text/fhirpath",
        "expression": "iif(%weightKg < 35, 130, 150)"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "ironStores",
        "language": "text/fhirpath",
        "expression": "iif(%weightKg < 35, 15 * %weight, 500)"
      }
    },
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-extractAllocateId",
      "valueString": "ivIronOrderId"
    },
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-extractAllocateId",
      "valueString": "eduProcedureId"
    }
  ],
  "url": "https://aehrc.github.io/qh-connectathon/track1/solutions/Questionnaire/pam-root",
