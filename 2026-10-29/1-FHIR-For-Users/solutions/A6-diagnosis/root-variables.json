{
  "comment": "Variables the A6 module needs on the PAM root form (pam-root.json). 'existing' are on pam-root 0.1.0; 'new' must be added; 'hbThresholdProposed' is an optional stricter replacement for hbThreshold.",
  "existing": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "sexCode",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-sex').answer.value.code"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "hb",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-hb').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "ferritin",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-ferritin').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "tsat",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-tsat').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "crp",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-crp').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "hbThreshold",
        "language": "text/fhirpath",
        "expression": "iif(%sexCode = 'male', 130, 120)"
      }
    }
  ],
  "new": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "mcv",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-mcv').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "egfr",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='pam-egfr').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "anaemia",
        "language": "text/fhirpath",
        "expression": "%hb <= %hbThreshold"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "ironDeficiency",
        "language": "text/fhirpath",
        "expression": "%ferritin < 100 or (%tsat < 20 and %ferritin >= 100 and %ferritin <= 300)"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "inflammation",
        "language": "text/fhirpath",
        "expression": "%crp > 10"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "pathway",
        "language": "text/fhirpath",
        "expression": "iif(%anaemia.empty() or %ironDeficiency.empty(), {}, iif(%anaemia, iif(%ferritin < 100, 'ida', iif(%ironDeficiency, iif(%inflammation, 'acd', 'ida'), 'anaemia')), iif(%ironDeficiency, 'id', 'none')))"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "suggestedDxCode",
        "language": "text/fhirpath",
        "expression": "iif(%pathway = 'ida', '87522002', iif(%pathway = 'acd', '234347009', iif(%pathway = 'id', '35240004', iif(%pathway = 'anaemia', '271737000', {}))))"
      }
    }
  ],
  "hbThresholdProposed": {
    "url": "http://hl7.org/fhir/StructureDefinition/variable",
    "valueExpression": {
      "name": "hbThreshold",
      "language": "text/fhirpath",
      "expression": "iif(%sexCode = 'male', 130, iif(%sexCode = 'female', 120, {}))"
    }
  }
}
