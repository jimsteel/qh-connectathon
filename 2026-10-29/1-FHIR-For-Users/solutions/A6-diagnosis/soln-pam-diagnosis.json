  ],
  "url": "https://aehrc.github.io/qh-connectathon/track1/solutions/Questionnaire/pam-diagnosis",
  "version": "0.2.0",
  "name": "PAMDiagnosis",
  "title": "PAM module — Diagnosis and decision support (full solution)",
  "status": "draft",
  "experimental": true,
  "date": "2026-10-28",
  "publisher": "FHIR in Queensland Health Connectathon — Track 1 (synthetic demo, not for clinical use)",
  "description": "Full solution for scenario A6: anaemia, iron deficiency and inflammation and the pathway classification as calculated expressions (sex-specific Hb thresholds); a suggested SNOMED CT-AU diagnosis written back as a Condition; limited consent / refusal of blood products as a Flag; a requested target Hb as a Goal. Needs the root variables in root-variables.json. Extends pam-diagnosis 0.1.0. Synthetic demo, not for clinical use.",
  "item": [
    {
      "linkId": "pam-diagnosis-section",
      "text": "Diagnosis",
      "type": "group",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/variable",
          "valueExpression": {
            "name": "dxWaitlist",
            "language": "application/x-fhir-query",
            "expression": "ServiceRequest?patient={{%patient.id}}&status=active&_count=50"
          }
        }
      ],
      "item": [
        {
          "linkId": "pam-diagnosis-module",
          "text": "Module",
          "type": "string",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-hidden",
              "valueBoolean": true
            }
          ],
          "initial": [
            {
              "valueString": "pam-diagnosis|0.2.0"
            }
          ]
        },
        {
          "linkId": "pam-findings-intro",
          "type": "display",
          "text": "Findings, calculated from the pathology results and sex",
          "_text": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/rendering-xhtml",
                "valueString": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><b>Findings</b>, calculated from the pathology results and sex (decision rules from the track's FHIR mapping; to confirm with Metro North)</p></div>"
              }
            ]
          }
        },
        {
          "linkId": "pam-anaemia",
          "text": "Anaemia (Hb ≤ 130 g/L male, ≤ 120 g/L female)",
          "type": "boolean",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%anaemia"
              }
            }
          ],
          "readOnly": true
        },
        {
          "linkId": "pam-anaemia-severity",
          "text": "Anaemia severity (WHO)",
          "type": "string",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%anaemia, iif(%hb < 80, 'Severe (Hb < 80 g/L)', iif(%hb < 110, 'Moderate (Hb 80–109 g/L)', 'Mild (Hb 110 g/L to the threshold)')), {})"
              }
            }
          ],
          "readOnly": true
        },
        {
          "linkId": "pam-iron-deficiency",
          "text": "Iron deficiency (ferritin < 100 µg/L, or TSAT < 20% with ferritin 100–300 µg/L)",
          "type": "boolean",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%ironDeficiency"
              }
            }
          ],
          "readOnly": true
        },
        {
          "linkId": "pam-inflammation",
          "text": "Inflammation (CRP > 10 mg/L)",
          "type": "boolean",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%inflammation"
              }
            }
          ],
          "readOnly": true
        },
        {
          "linkId": "pam-pathway",
          "text": "Pathway",
          "type": "text",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%pathway.exists(), iif(%pathway = 'ida', 'Iron deficiency anaemia: iron replacement (see Treatment)', iif(%pathway = 'acd', 'Anaemia with inflammation (CRP > 10 mg/L) and possible functional iron deficiency (ferritin 100–300 µg/L, TSAT < 20%): anaemia of chronic disease; consider IV iron and medical review', iif(%pathway = 'id', 'Iron deficiency without anaemia: consider iron replacement', iif(%pathway = 'anaemia', 'Anaemia without iron deficiency: look for other causes (B12, folate, renal function, haematology review)', iif(%pathway = 'none', 'No anaemia or iron deficiency: no blood management intervention needed', {}))))) & iif(%pathway = 'anaemia', iif(%mcv > 100, '. Macrocytic (MCV > 100 fL)', iif(%mcv < 80, '. Microcytic (MCV < 80 fL)', '')) & iif(%egfr < 60, '. eGFR < 60: consider anaemia of chronic kidney disease', ''), ''), {})"
              }
            }
          ],
          "readOnly": true
        },
        {
          "linkId": "pam-diagnosis-suggested",
          "text": "Suggested diagnosis",
          "type": "string",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "iif(%suggestedDxCode.exists(), iif(%suggestedDxCode = '87522002', 'Iron deficiency anaemia (SNOMED CT 87522002)', iif(%suggestedDxCode = '234347009', 'Anaemia of chronic disease (SNOMED CT 234347009)', iif(%suggestedDxCode = '35240004', 'Iron deficiency (SNOMED CT 35240004)', iif(%suggestedDxCode = '271737000', 'Anaemia (SNOMED CT 271737000)', {})))), iif(%pathway = 'none', 'None: no anaemia or iron deficiency', {}))"
              }
            }
          ],
          "readOnly": true
        },
        {
          "linkId": "pam-diagnosis",
          "text": "Diagnosis (confirm)",
          "type": "choice",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtract",
              "extension": [
                {
                  "url": "template",
                  "valueReference": {
                    "reference": "#PAMDiagnosisTemplate"
                  }
                }
              ]
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button"
                  }
                ]
              }
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://snomed.info/sct",
                "code": "87522002",
                "display": "Iron deficiency anaemia"
              }
            },
            {
              "valueCoding": {
                "system": "http://snomed.info/sct",
                "code": "35240004",
                "display": "Iron deficiency"
              }
            },
            {
              "valueCoding": {
                "system": "http://snomed.info/sct",
                "code": "234347009",
                "display": "Anaemia of chronic disease"
              }
            },
            {
              "valueCoding": {
                "system": "http://snomed.info/sct",
                "code": "707323002",
                "display": "Anaemia in chronic kidney disease"
              }
            },
            {
              "valueCoding": {
                "system": "http://snomed.info/sct",
                "code": "271737000",
                "display": "Anaemia"
              }
            }
          ]
        },
        {
          "linkId": "pam-diagnosis-differs",
          "type": "display",
          "text": "The diagnosis differs from the suggested one: check the findings.",
          "_text": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/rendering-xhtml",
                "valueString": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p style=\"color:#B9531A\"><b>The diagnosis differs from the suggested one</b>: check the findings.</p></div>"
              }
            ]
          },
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%suggestedDxCode.exists() and %resource.repeat(item).where(linkId='pam-diagnosis').answer.value.exists() and %resource.repeat(item).where(linkId='pam-diagnosis').answer.value.code != %suggestedDxCode"
              }
            }
          ]
        },
        {
          "linkId": "pam-diagnosis-other",
          "text": "Other diagnosis (search SNOMED CT-AU)",
          "type": "choice",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtract",
              "extension": [
