        {
          "linkId": "pam-target-hb-group",
          "text": "Requested target haemoglobin",
          "type": "group",
          "item": [
            {
              "linkId": "pam-target-hb",
              "text": "Target Hb before surgery",
              "type": "decimal",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
                  "valueCoding": {
                    "system": "http://unitsofmeasure.org",
                    "code": "g/L",
                    "display": "g/L"
                  }
                },
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtract",
                  "extension": [
                    {
                      "url": "template",
                      "valueReference": {
                        "reference": "#PAMTargetHbGoalTemplate"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "linkId": "pam-target-hb-gap",
              "text": "Increase needed from the latest Hb",
              "type": "decimal",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
                  "valueCoding": {
                    "system": "http://unitsofmeasure.org",
                    "code": "g/L",
                    "display": "g/L"
                  }
                },
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "iif(%resource.repeat(item).where(linkId='pam-target-hb').answer.value.exists() and %hb.exists(), iif(%resource.repeat(item).where(linkId='pam-target-hb').answer.value > %hb, %resource.repeat(item).where(linkId='pam-target-hb').answer.value - %hb, 0), {})"
                  }
                }
              ],
              "readOnly": true
            },
            {
              "linkId": "pam-target-hb-by",
              "text": "Requested by",
              "type": "choice",
              "extension": [
                {
