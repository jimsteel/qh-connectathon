                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "autocomplete"
                  }
                ]
              }
            }
          ],
          "answerValueSet": "http://snomed.info/sct/32506021000036107?fhir_vs=ecl/<< 271737000 OR << 35240004"
        },
