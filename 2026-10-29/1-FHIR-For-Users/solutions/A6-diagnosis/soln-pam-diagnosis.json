                    "code": "patient",
                    "display": "Patient"
                  }
                }
              ]
            },
            {
              "linkId": "pam-target-hb-due",
              "text": "By (booked surgery date)",
              "type": "date",
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
