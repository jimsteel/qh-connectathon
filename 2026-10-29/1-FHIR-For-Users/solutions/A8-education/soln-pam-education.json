          "valueExpression": {
            "name": "eduSurgery",
            "language": "application/x-fhir-query",
            "expression": "ServiceRequest?patient={{%patient.id}}&category=https://aehrc.github.io/qh-connectathon/track1/CodeSystem/elective-category|&_sort=-authored&_count=1&_include=ServiceRequest:requester&_include=ServiceRequest:performer"
