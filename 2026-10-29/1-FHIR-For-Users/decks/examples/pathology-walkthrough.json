{
  "resourceType": "Questionnaire",
  "id": "pathology-walkthrough",
  "extension": [
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-launchContext",
      "extension": [
        {
          "url": "name",
          "valueCoding": {
            "system": "http://hl7.org/fhir/uv/sdc/CodeSystem/launchContext",
            "code": "patient"
          }
        },
        {
          "url": "type",
          "valueCode": "Patient"
        }
      ]
    }
  ],
  "url": "https://aehrc.github.io/qh-connectathon/track1/Questionnaire/pathology-walkthrough",
  "version": "0.1.0",
  "name": "PathologyWalkthrough",
  "title": "Pathology results (walkthrough)",
  "status": "draft",
  "experimental": true,
  "date": "2026-10-28",
  "publisher": "FHIR in Queensland Health Connectathon — Track 1 (synthetic demo, not for clinical use)",
  "description": "Cut-down version of the PAM Pathology module (questionnaires/modules/pam-pathology.json), built up step by step in the Track 1 forms decks. Synthetic demo, not for clinical use.",
  "item": [
    {
      "linkId": "pam-pathology",
      "text": "Pathology",
      "type": "group",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/variable",
          "valueExpression": {
            "name": "latestHb",
            "language": "application/x-fhir-query",
            "expression": "Observation?code=http://loinc.org|718-7&patient={{%patient.id}}&_sort=-date&_count=1"
          }
        },
        {
          "url": "http://hl7.org/fhir/StructureDefinition/variable",
          "valueExpression": {
            "name": "latestFerritin",
            "language": "application/x-fhir-query",
            "expression": "Observation?code=http://loinc.org|2276-4&patient={{%patient.id}}&_sort=-date&_count=1"
          }
        }
      ],
      "item": [
        {
          "linkId": "pam-hb",
          "text": "Haemoglobin (Hb)",
          "type": "decimal",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
              "valueCoding": {
                "system": "http://unitsofmeasure.org",
                "code": "g/L",
                "display": "g/L"
              }
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%latestHb.entry.resource.value.value"
              }
            }
          ]
        },
        {
          "linkId": "pam-ferritin",
          "text": "Ferritin",
          "type": "decimal",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
              "valueCoding": {
                "system": "http://unitsofmeasure.org",
                "code": "ug/L",
                "display": "µg/L"
              }
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%latestFerritin.entry.resource.value.value"
              }
            }
          ]
        },
        {
          "linkId": "pam-hb-date",
          "text": "Date of latest Hb",
          "type": "date",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%latestHb.entry.resource.effective.toString().substring(0, 10)"
              }
            }
          ]
        },
        {
          "linkId": "pam-ext",
          "text": "Results from an external lab",
          "type": "group",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtract",
              "extension": [
                {
                  "url": "template",
                  "valueReference": {
                    "reference": "#PAMExternalResultTemplate"
                  }
                }
              ]
            }
          ],
          "repeats": true,
          "item": [
            {
              "linkId": "pam-ext-test",
              "text": "Test",
              "type": "choice",
              "answerOption": [
                {
                  "valueCoding": {
                    "system": "http://loinc.org",
                    "code": "718-7",
                    "display": "Haemoglobin (Hb)"
                  }
                },
                {
                  "valueCoding": {
                    "system": "http://loinc.org",
                    "code": "2276-4",
                    "display": "Ferritin"
                  }
                }
              ]
            },
            {
              "linkId": "pam-ext-value",
              "text": "Result",
              "type": "decimal"
            },
            {
              "linkId": "pam-ext-date",
              "text": "Collected",
              "type": "date"
            }
          ]
        }
      ]
    }
  ],
  "contained": [
    {
      "resourceType": "Observation",
      "id": "PAMExternalResultTemplate",
      "status": "final",
      "category": [
        {
          "coding": [
            {
              "system": "http://terminology.hl7.org/CodeSystem/observation-category",
              "code": "laboratory",
              "display": "Laboratory"
            }
          ]
        }
      ],
      "code": {
        "coding": [
          {
            "system": "http://loinc.org",
            "_code": {
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtractValue",
                  "valueString": "item.where(linkId='pam-ext-test').answer.value.code"
                }
              ]
            }
          }
        ],
        "_text": {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtractValue",
              "valueString": "item.where(linkId='pam-ext-test').answer.value.display"
            }
          ]
        }
      },
      "subject": {
        "_reference": {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtractValue",
              "valueString": "%resource.subject.reference"
            }
          ]
        }
      },
      "_effectiveDateTime": {
        "extension": [
          {
            "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtractValue",
            "valueString": "item.where(linkId='pam-ext-date').answer.value.toString()"
          }
        ]
      },
      "valueQuantity": {
        "_value": {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtractValue",
              "valueString": "item.where(linkId='pam-ext-value').answer.value"
            }
          ]
        },
        "system": "http://unitsofmeasure.org",
        "_code": {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtractValue",
              "valueString": "iif(item.where(linkId='pam-ext-test').answer.value.code = '718-7', 'g/L', iif(item.where(linkId='pam-ext-test').answer.value.code = '2276-4', 'ug/L', iif(item.where(linkId='pam-ext-test').answer.value.code = '14801-5', '%', 'mg/L')))"
            }
          ]
        },
        "_unit": {
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtractValue",
              "valueString": "iif(item.where(linkId='pam-ext-test').answer.value.code = '718-7', 'g/L', iif(item.where(linkId='pam-ext-test').answer.value.code = '2276-4', 'µg/L', iif(item.where(linkId='pam-ext-test').answer.value.code = '14801-5', '%', 'mg/L')))"
            }
          ]
        }
      }
    }
  ]
}
